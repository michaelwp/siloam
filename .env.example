MONGODB_URI=

# Sign-in protection
# MAX_FAILED_LOGINS=3      # wrong passwords in a row before an account locks
# LOCK_DURATION=3m         # how long the lock lasts (e.g. 90s, 3m, 1h); an admin can unlock earlier
# API_RATE_LIMIT=600       # /api requests per client IP per minute
# AUTH_RATE_LIMIT=20       # sign-in attempts per client IP per minute
# TRUSTED_PROXIES=         # reverse proxy IPs/CIDRs (e.g. 127.0.0.1,10.0.0.0/8) when behind nginx/Caddy

# Jadwal Ibadah: the local time zone of service times (default WITA, Manado)
# APP_TIMEZONE=Asia/Makassar
