MONGODB_URI=

# Sign-in protection
# MAX_FAILED_LOGINS=3      # wrong passwords in a row before an account locks
# LOCK_DURATION=3m         # how long the lock lasts (e.g. 90s, 3m, 1h); an admin can unlock earlier
# API_RATE_LIMIT=600       # /api requests per client IP per minute
# AUTH_RATE_LIMIT=20       # sign-in attempts per client IP per minute
# TRUSTED_PROXIES=         # reverse proxy IPs/CIDRs (e.g. 127.0.0.1,10.0.0.0/8) when behind nginx/Caddy

# Jadwal Ibadah: the local time zone of service times (default WITA, Manado)
# APP_TIMEZONE=Asia/Makassar

# Android app: the newest version and where its APK is downloaded. Installed
# apps older than this show "versi baru tersedia" with a link to download it.
# Admins can set this on the "Aplikasi Android" page instead (which then wins).
# Leave both empty to turn the update notice off.
# ANDROID_LATEST_VERSION=1.0.1
# ANDROID_DOWNLOAD_URL=https://github.com/michaelwp/siloam/releases/latest/download/jemaat-siloam.apk

# Log Aktivitas (audit log): days to keep entries
# AUDIT_RETENTION_DAYS=365
