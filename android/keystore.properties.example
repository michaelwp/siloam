# Copy to keystore.properties (git-ignored) to sign release builds:
#   cp keystore.properties.example keystore.properties
# Create the key once (keep the .jks file and both passwords safe, and backed
# up: every update must be signed with this same key):
#   keytool -genkeypair -v -keystore jemaat-siloam.jks -keyalg RSA -keysize 4096 \
#     -validity 36500 -alias jemaat-siloam
# Paths are relative to the android/ folder. Never commit the .jks file or
# keystore.properties.
storeFile=jemaat-siloam.jks
storePassword=CHANGE-ME
keyAlias=jemaat-siloam
keyPassword=CHANGE-ME
